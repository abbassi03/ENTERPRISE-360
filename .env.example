# Generate a private value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CURRENCY_CODE=MAD
COMPANY_NAME=Atlas Enterprise Group
TIME_ZONE=Africa/Casablanca

# Default local development database. Use postgres in Docker if needed.
DB_ENGINE=sqlite
POSTGRES_DB=enterprise360
POSTGRES_USER=enterprise360
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Used only when the demo admin account is first created.
ENTERPRISE_ADMIN_PASSWORD=ChangeMe12345!
